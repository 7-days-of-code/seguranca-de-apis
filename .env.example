# Copie este arquivo para .env e troque os valores.
# O .env está no .gitignore e nunca vai para o repositório.

# Segredo usado para assinar o token de sessão (você usa isto a partir do Dia 2).
BANCO_POP_SEGREDO=troque-este-valor-por-um-aleatorio-longo

# Caminho do arquivo SQLite (opcional).
BANCO_POP_BANCO=banco_pop.db
